# Spinning Mill Database (Canonical Cluster Database)
MONGODB_URI="mongodb://localhost:27017/scm-spinning"

# Same Database that IoT uses
IOT_MONGODB_URI="mongodb://127.0.0.1:27017/scm-spinning"
IOT_DB_NAME="scm-spinning"
DB_NAME="scm-spinning"

# Live IoT Remote Backend API (Railway is primary production, Render fallback)
IOT_COMMON_API="https://iot-machine-backend-production.up.railway.app/api/common"
NEXT_PUBLIC_IOT_COMMON_API="https://iot-machine-backend-production.up.railway.app/api/common"
IOT_REMOTE_API="https://iot-machine-backend-production.up.railway.app/api"
NEXT_PUBLIC_IOT_REMOTE_API="https://iot-machine-backend-production.up.railway.app/api"

# Application Server Port
PORT=3000
